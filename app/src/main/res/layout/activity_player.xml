<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Barra superior -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/btnDown"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@android:color/white"
            android:contentDescription="@string/btn_down_desc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/playing_from_library"
            android:textColor="#B3B3B3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_more_vert"
            app:tint="@android:color/white"
            android:contentDescription="@string/btn_more_desc" />
    </RelativeLayout>

    <!-- Carátula Grande de la Canción -->
    <ImageView
        android:id="@+id/imgPlayerCover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="32dp"
        android:scaleType="centerCrop"
        android:src="@drawable/default_song_cover"
        android:elevation="8dp"
        android:contentDescription="@string/song_cover_desc" />

    <!-- Info y botón de Favorito -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/default_song_title"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/default_artist_name"
                android:textColor="#B3B3B3"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="#1DB954"
            android:contentDescription="@string/btn_favorite_desc" />
    </LinearLayout>

    <!-- Barra de Progreso y Tiempos -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@android:color/white"
        android:thumbTint="@android:color/white" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_initial"
            android:textColor="#B3B3B3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/time_end"
            android:textColor="#B3B3B3"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Controles de Reproducción -->
    <LinearLayout
        android:layout_width="422dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5">

        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:contentDescription="@string/btn_shuffle_desc"
            android:src="@drawable/ic_shuffle"
            app:tint="#1DB954" />

        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/btn_previous_desc"
            android:src="@drawable/ic_skip_previous"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:contentDescription="@string/btn_play_pause_desc"
            android:src="@drawable/ic_pause"
            app:backgroundTint="@android:color/white"
            app:tint="@android:color/black" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/btn_next_desc"
            android:src="@drawable/ic_skip_next"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/btnRepeat"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:contentDescription="@string/btn_repeat_desc"
            android:src="@drawable/ic_repeat"
            app:tint="#B3B3B3" />
    </LinearLayout>

</LinearLayout>